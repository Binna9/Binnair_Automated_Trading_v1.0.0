FROM python:3.12-bookworm

ENV PYTHONUNBUFFERED=1 \
    TZ=Asia/Seoul \
    HF_HOME=/data/huggingface \
    PIP_NO_CACHE_DIR=1 \
    BINNAIR_FINCAST_REPO=/opt/fincast/src

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl git libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY requirements-fincast.txt ./
COPY src ./src
COPY scripts ./scripts

# TimesFM (engine) + FinCast 추론 의존성 전부
RUN pip install --upgrade pip \
    && pip install ".[engine]" \
    && pip install -r requirements-fincast.txt

# FinCast-fts (ffm). 가중치(.pth)는 /data 볼륨 — 이미지에 넣지 않음
RUN git clone --depth 1 https://github.com/vincent05r/FinCast-fts.git /opt/fincast \
    && pip install -e /opt/fincast \
    && python -c "from ffm import FFM, FFmHparams; import einx, einops, pandas, jax, sklearn, utilsforecast; print('FinCast import smoke OK')"

CMD ["python", "scripts/run_engine.py"]
